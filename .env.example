# Copia este fichero a .env y ajusta los valores.
# docker-compose.yml lee estas variables con estos mismos valores por defecto.

# Imagen de PostgreSQL. Si cargas una imagen propia con `docker load`,
# pon aquí el repo:tag que imprima el comando (p. ej. postgres:16-alpine).
POSTGRES_IMAGE=postgres:16-alpine

POSTGRES_DB=cifracontrol
POSTGRES_USER=cifracontrol
POSTGRES_PASSWORD=cifracontrol
